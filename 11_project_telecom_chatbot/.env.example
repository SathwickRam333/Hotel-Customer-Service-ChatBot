# ==============================================================
# PRIMARY LLM: OpenAI API (gpt-4o-mini / gpt-4o)
# Paste your OpenAI API Key below (starts with sk-proj-... or sk-...)
# ==============================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ==============================================================
# SECONDARY FALLBACK: Groq API
# ==============================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Mem0 Cloud API Key (from https://mem0.ai). If omitted, runs in local memory mode.
MEM0_API_KEY=your_mem0_api_key_here
